<?php
/**
 * contacts.php — the private half of the site. NEVER commit the filled-in version.
 *
 * Copy to contacts.php and fill in the real destinations. Every key here is a
 * channel code used by index.html as go.php?c=<key>. If a key is missing, that
 * button 404s; if the whole file is missing, every button returns
 * "Contact configuration missing." (which is the current state of the live site).
 *
 * Phone numbers go in E.164 format: +15551234567 — no spaces, dashes or brackets.
 */

declare(strict_types=1);

return [

    // ---- Chris: personal channels, fastest first ------------------------------

    // WhatsApp voice call. The ?call=voice hint opens the call sheet rather than
    // the chat thread on most builds; if your WhatsApp opens the chat anyway,
    // it's a WhatsApp behaviour, not a config error.
    'whatsapp-call'    => 'https://wa.me/15551234567?call=voice',
    'whatsapp-message' => 'https://wa.me/15551234567',

    // FaceTime. facetime-audio: is voice only; use facetime: if you want video.
    'facetime'         => 'facetime-audio:you@example.com',
    'imessage'         => 'sms:+15551234567',           // opens Messages on Apple devices
    'signal'           => 'https://signal.me/#p/+15551234567',
    'telegram'         => 'https://t.me/yourhandle',

    // Google Chat — the kid- and student-safe channel. Use a Chat space invite
    // link, or a mailto: to the Google account so a student can start a chat
    // without knowing any phone number.
    'google-chat'      => 'https://mail.google.com/chat/u/0/#chat/dm/REPLACE_WITH_DM_ID',

    'sms'              => 'sms:+15551234567',
    'email'            => 'mailto:chris@chrislacey.com',
    'schedule'         => 'https://book.chrislacey.com',
    'call'             => 'tel:+15551234567',

    // ---- Student or Friend of Addy -------------------------------------------
    // Deliberately NOT your personal cell. Point these at an inbox or a form so
    // students and their parents never end up with your phone number.
    'addy-student'     => 'mailto:REPLACE@chrislacey.com?subject=Student%20of%20Addy',
    'addy-friend'      => 'mailto:REPLACE@chrislacey.com?subject=Friend%20of%20Addy',
    // The one exception: this is the "something is wrong" path, so it should be
    // as fast as the top of the page.
    'addy-urgent'      => 'https://wa.me/15551234567?call=voice',

    // ---- Brasil ---------------------------------------------------------------
    'brasil'           => 'https://REPLACE-with-your-brasil-page',

    // ---- NGNS -----------------------------------------------------------------
    'ngns-discord'     => 'https://discord.gg/ngns',

    // ---- Business -------------------------------------------------------------
    'barandcocoa'      => 'https://barandcocoa.com',

    // ---- Elsewhere ------------------------------------------------------------
    'website'          => 'https://chrislacey.com',
    'linkedin'         => 'https://www.linkedin.com/in/REPLACE',

];
